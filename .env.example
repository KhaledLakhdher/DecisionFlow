# ---------------------------------------------------------------------------
# DecisionFlow — copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

ENVIRONMENT=development
DEBUG=true

# --- Security -------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_generate_a_64_byte_urlsafe_token
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14

# --- Postgres (control plane: tenancy, catalog, embeddings) ---------------
POSTGRES_USER=decisionflow
POSTGRES_PASSWORD=decisionflow
POSTGRES_DB=decisionflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Application role used at runtime. It is deliberately NOT the table owner,
# because Postgres RLS policies do not apply to a table's owner by default.
APP_DB_USER=decisionflow_app
APP_DB_PASSWORD=decisionflow_app

# --- Redis (ARQ job queue) -------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Object storage (MinIO, S3-compatible) ---------------------------------
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=decisionflow-uploads
S3_REGION=us-east-1

# --- Data plane ------------------------------------------------------------
# Root directory for per-workspace DuckDB analytical stores.
DUCKDB_STORAGE_PATH=./storage/duckdb
MAX_UPLOAD_BYTES=209715200

# --- LLM (Gemini) ----------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REASONING_MODEL=gemini-2.5-pro

# --- Frontend --------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
